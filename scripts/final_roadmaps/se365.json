    {"title": "Heuristic evaluation vs cognitive walkthrough vs usability test", "ask": "Experts with principles, experts stepping through a task, or real users?", "rows": [["Heuristic evaluation", "3–5 experts check against heuristics", "No users"], ["Cognitive walkthrough", "Experts step through a task for learnability", "No users"], ["Usability testing", "Real users do tasks, measured", "Lab"]], "test": ["Experts ask at each step whether a new user would know what to do.", "Cognitive walkthrough."], "study": ["L13", "L12"]},
