  "items": [
    {
      "id": "data-comm-components",
      "kind": "list",
      "chapter": "ch1",
      "name": "Five components of data communication",
      "memorize": "Message, sender, receiver, transmission medium, protocol",
      "match": ["components of data communication", "transmission medium"]
    },
    {
      "id": "network-criteria",
      "kind": "list",
      "chapter": "ch1",
      "name": "Network criteria: performance, reliability, security",
      "memorize": "Performance (throughput up, delay down; they conflict) · Reliability (failure frequency, recovery time) · Security",
      "match": ["reliability", "throughput"]
    },
    {
      "id": "connection-types",
      "kind": "compare",
      "chapter": "ch1",
      "name": "Point-to-point vs multipoint",
      "match": ["point-to-point", "multipoint"]
    },
    {
      "id": "data-flow",
      "kind": "compare",
      "chapter": "ch1",
      "name": "Simplex, half-duplex, full-duplex",
      "memorize": "Simplex: keyboard, monitor · Half: walkie-talkie · Full: telephone",
      "match": ["duplex", "simplex", "walkie"]
    },
    {
      "id": "topologies",
      "kind": "compare",
      "chapter": "ch1",
      "name": "Topologies: mesh, star, bus, ring, hybrid (pros and cons)",
      "match": [
        "topology",
        "\\bmesh\\b",
        "\\bstar\\b",
        "\\bbus\\b",
        "\\bring\\b"
      ]
    },
    {
      "id": "f-mesh-links",
      "kind": "formula",
      "chapter": "ch1",
      "name": "Mesh links",
      "memorize": "Links = N(N − 1) / 2 · I/O ports per device = N − 1",
      "match": ["N\\s*\\(N\\s*-\\s*1\\)", "\\(N\\s*-\\s*1\\s*\\)\\s*per device"]
    },
    {
      "id": "f-topology-links",
      "kind": "formula",
      "chapter": "ch1",
      "name": "Links in star, ring, bus",
      "memorize": "Star = N · Ring = N · Bus = 1 main cable + N drop lines",
      "match": ["Number of links"]
    },
    {
      "id": "network-types",
      "kind": "compare",
      "chapter": "ch1",
      "name": "LAN, MAN, WAN and internetworks",
      "match": ["\\bLAN\\b", "\\bMAN\\b", "\\bWAN\\b"]
    },
    {
      "id": "isp-tiers",
      "kind": "list",
      "chapter": "ch1",
      "name": "ISP tiers and peering (private peering vs IXP)",
      "memorize": "Tier 1 backbones (Sprint, AT&T) · Tier 2 national (STC, Mobily) · Tier 3 local · Private peering points vs Internet Exchange Points",
      "match": ["\\bISP", "peering", "\\bIXP\\b", "tier"]
    },
    {
      "id": "standards-orgs",
      "kind": "list",
      "chapter": "ch1",
      "name": "Protocols and standards organizations",
      "memorize": "ISO, ITU-T, ANSI, IEEE (LAN/MAN), W3C",
      "match": ["\\bstandard", "\\bprotocol:"]
    },
    {
      "id": "layering",
      "kind": "concept",
      "chapter": "ch1",
      "name": "Why layered architecture (advantages)",
      "match": [
        "layered architecture",
        "well-defined interface",
        "Layer n-1",
        "logical groupings"
      ]
    },
    {
      "id": "osi-layers",
      "kind": "list",
      "chapter": "ch1",
      "name": "OSI 7 layers and their jobs",
      "memorize": "Application, Presentation, Session, Transport, Network, Data Link, Physical (\"All People Seem To Need Data Processing\")",
      "match": ["\\bOSI\\b", "presentation", "session"]
    },
    {
      "id": "tcpip-layers",
      "kind": "list",
      "chapter": "ch1",
      "name": "TCP/IP 5 layers and PDU names",
      "memorize": "Application = message · Transport = segment · Network = packet/datagram · Data link = frame · Physical = bits",
      "match": [
        "TCP/IP Protocol Suite",
        "Layers in the TCP/IP",
        "TCP/IP and OSI",
        "\\bPDU\\b",
        "Original TCP/IP Model"
      ]
    },
    {
      "id": "encapsulation",
      "kind": "process",
      "chapter": "ch1",
      "name": "Encapsulation: how hosts talk over a network",
      "match": ["encapsulat", "How Hosts Talk"]
    },
    {
      "id": "addresses-per-layer",
      "kind": "compare",
      "chapter": "ch1",
      "name": "Addresses per layer: MAC (next hop), IP (end to end), port (process)",
      "match": [
        "Layer Addresses",
        "physical address",
        "logical address",
        "port address",
        "next-hop destination",
        "end-to-end destination",
        "process addressing"
      ]
    },
    {
      "id": "delivery-types",
      "kind": "compare",
      "chapter": "ch1",
      "name": "Hop-to-hop vs host-to-host vs process-to-process delivery",
      "match": [
        "hop-to-hop",
        "node-to-node",
        "host-to-host",
        "source-to-destination",
        "process-to-process"
      ]
    },
    {
      "id": "analog-digital",
      "kind": "compare",
      "chapter": "ch2",
      "name": "Analog vs digital data and signals, periodic vs aperiodic",
      "match": ["analog", "digital", "periodic"]
    },
    {
      "id": "f-frequency-period",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Frequency and period",
      "memorize": "f = 1 / T and T = 1 / f",
      "match": ["frequency", "period"]
    },
    {
      "id": "f-bit-interval",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Bit interval",
      "memorize": "Bit interval = 1 / bit rate",
      "match": ["bit interval"]
    },
    {
      "id": "simple-composite",
      "kind": "compare",
      "chapter": "ch2",
      "name": "Simple vs composite signals",
      "match": ["composite", "simple signal"]
    },
    {
      "id": "impairments",
      "kind": "list",
      "chapter": "ch2",
      "name": "Impairments: attenuation, distortion, noise",
      "memorize": "Attenuation (energy loss, fix with amplifiers or repeaters) · Distortion (shape changes) · Noise: thermal, induced, crosstalk, impulse",
      "match": ["attenuation", "distortion", "noise", "impairment"]
    },
    {
      "id": "f-propagation-time",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Propagation time",
      "memorize": "Propagation time = distance / propagation speed (light: 3 × 10⁸ m/s in vacuum, about 2/3 of that in cable)",
      "match": ["propagation time", "propagation speed"]
    },
    {
      "id": "f-transmission-time",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Transmission time",
      "memorize": "Transmission time = message size in bits / bandwidth (bps)",
      "match": ["transmission time"]
    },
    {
      "id": "f-latency",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Latency",
      "memorize": "Latency = transmission + propagation + processing + queuing time",
      "match": ["latency", "queuing"]
    },
    {
      "id": "f-bandwidth-delay",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Bandwidth-delay product",
      "memorize": "Bandwidth × delay = number of bits that fill the link",
      "match": ["bandwidth-delay", "filling the link"]
    },
    {
      "id": "f-wavelength",
      "kind": "formula",
      "chapter": "ch2",
      "name": "Wavelength",
      "memorize": "Wavelength = propagation speed × period = propagation speed / frequency",
      "match": ["wavelength"]
    },
    {
      "id": "guided-media",
      "kind": "compare",
      "chapter": "ch2",
      "name": "Guided media: twisted pair (UTP/STP), coaxial, fiber",
      "match": ["twisted", "\\bUTP\\b", "\\bSTP\\b", "coax", "fiber"]
    },
    {
      "id": "n-utp-categories",
      "kind": "number",
      "chapter": "ch2",
      "name": "UTP categories",
      "memorize": "CAT5e 100 MHz/1 Gbps · CAT6 250 MHz/1 Gbps · CAT6a 500 MHz/10 Gbps · CAT7 600 MHz/10 Gbps (shielded) · CAT8 2000 MHz/25–40 Gbps (shielded)",
      "match": ["CAT5e", "CAT6", "CAT8"]
    },
    {
      "id": "cabling",
      "kind": "compare",
      "chapter": "ch2",
      "name": "Straight-through vs crossover cabling",
      "memorize": "Crossover for like devices: PC–PC, hub–hub, switch–switch, hub–switch, router–PC",
      "match": ["crossover", "straight-through", "RJ-45"]
    },
    {
      "id": "fiber-parts",
      "kind": "list",
      "chapter": "ch2",
      "name": "Optical fiber: core, cladding, jacket; pros and cons",
      "match": ["cladding", "fiber"]
    },
    {
      "id": "n-wireless-bands",
      "kind": "number",
      "chapter": "ch2",
      "name": "Wireless bands: radio, microwave, infrared",
      "memorize": "Radio < 300 MHz, omnidirectional, multicast · Microwave 300 MHz–300 GHz, line of sight, unicast · Infrared 300 GHz–400 THz, short range, no walls",
      "match": ["radio wave", "microwave", "infrared"]
    },
    {
      "id": "dll-services",
      "kind": "list",
      "chapter": "ch3a",
      "name": "Data link services",
      "memorize": "Framing, addressing, error control, flow control, access control (MAC sublayer)",
      "match": ["framing", "flow control", "error control", "access control"]
    },
    {
      "id": "framing",
      "kind": "compare",
      "chapter": "ch3a",
      "name": "Character-oriented vs bit-oriented framing",
      "memorize": "Flag 01111110 · Character-oriented: byte stuffing with ESC · Bit-oriented: stuff a 0 after five 1s",
      "match": ["character.oriented", "bit.oriented", "\\bflag\\b"]
    },
    {
      "id": "p-stuffing",
      "kind": "calc",
      "chapter": "ch3a",
      "name": "Byte stuffing and bit stuffing",
      "match": ["stuffing", "unstuff"]
    },
    {
      "id": "error-types",
      "kind": "compare",
      "chapter": "ch3a",
      "name": "Single-bit vs burst errors (burst length)",
      "match": ["single-bit", "burst"]
    },
    {
      "id": "f-burst-bits",
      "kind": "formula",
      "chapter": "ch3a",
      "name": "Bits hit by a burst",
      "memorize": "Bits affected = bandwidth × burst duration",
      "match": ["burst error"]
    },
    {
      "id": "p-parity",
      "kind": "calc",
      "chapter": "ch3a",
      "name": "Simple parity check (even and odd)",
      "match": ["parity"]
    },
    {
      "id": "p-2d-parity",
      "kind": "calc",
      "chapter": "ch3a",
      "name": "Two-dimensional parity",
      "match": ["two-dimensional parity", "Two-dimensional"]
    },
    {
      "id": "p-crc",
      "kind": "calc",
      "chapter": "ch3a",
      "name": "CRC encoding and checking (XOR division)",
      "match": ["\\bCRC\\b", "cyclic", "generator", "polynomial"]
    },
    {
      "id": "f-crc-burst",
      "kind": "formula",
      "chapter": "ch3a",
      "name": "CRC burst detection",
      "memorize": "Generator of degree r catches every burst ≤ r bits · misses 1/2^(r−1) of bursts of length r + 1 · misses 1/2^r of longer bursts",
      "match": ["burst errors with"]
    },
    {
      "id": "p-checksum",
      "kind": "calc",
      "chapter": "ch3a",
      "name": "Checksum (one's complement, sender and receiver steps)",
      "match": ["checksum", "one.s complement"]
    },
    {
      "id": "error-correction",
