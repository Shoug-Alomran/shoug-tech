{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoug-tech",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "ai": { "binding": "AI" },
  "analytics_engine_datasets": [
    { "binding": "ABOUT_STATS", "dataset": "about_assistant_topics" },
  ],
  "vars": {
    "CONTENT_ORIGIN": "https://shoug-tech.com",
    "ALLOWED_ORIGINS": "https://shoug-tech.com,https://www.shoug-tech.com,https://shoug-alomran.github.io",
  },
  "ratelimits": [
    {
      "name": "TRANSLATION_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
}
