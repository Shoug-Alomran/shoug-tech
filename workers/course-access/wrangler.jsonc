{
  "name": "shoug-course-access",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "shoug-ethics-private" },
  ],
  "vars": {
    "FIREBASE_PROJECT": "shoug-tech",
    "FIREBASE_API_KEY": "AIzaSyDUklr3u8laDZH2jhHVAO3BPE12GaPpOmI",
  },
  "routes": [
    {
      "pattern": "shoug-tech.com/styles/site-shell.css*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "shoug-tech.com/javascripts/site-shell.js*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "shoug-tech.com/javascripts/mobile-navigation.js*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "shoug-tech.com/styles/ethics-study-tools.css*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "shoug-tech.com/javascripts/ethics-study-tools.js*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "www.shoug-tech.com/styles/site-shell.css*",
      "zone_name": "shoug-tech.com",
    },
    {
      "pattern": "www.shoug-tech.com/javascripts/site-shell.js*",
      "zone_name": "shoug-tech.com",
