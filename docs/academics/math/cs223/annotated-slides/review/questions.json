        ["0", 0, ""]
      ]
    },
    {
      "d": "12-ch3-lecture-2",
      "id": "ded0aa5e",
      "s": 1,
      "p": "If B is A with two rows swapped and det A = 5, det B =",
      "o": [
        ["10", 0, ""],
