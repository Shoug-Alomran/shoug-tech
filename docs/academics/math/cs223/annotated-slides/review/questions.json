        ["2", 0, ""],
        ["1", 0, ""],
        ["4", 0, ""],
        ["3", 1, "7 − 4."]
      ]
    },
    {
      "d": "11-ch3-lecture-1",
      "id": "89768b07",
      "s": 8,
      "p": "det of [[2, 5, 1], [0, 3, 7], [0, 0, −1]] is:",
      "o": [
        ["−1", 0, ""],
        ["6", 0, ""],
