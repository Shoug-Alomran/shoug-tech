    {
      "d": "02-ch1-lecture-2",
      "id": "21a4279c",
      "s": 3,
      "p": "Each matrix is row equivalent to exactly one reduced echelon matrix.",
      "o": [
        ["True", 1, ""],
        ["False", 0, ""]
      ]
    },
    {
      "d": "02-ch1-lecture-2",
      "id": "88b2e22c",
      "s": 13,
      "p": "An augmented matrix reduces to a row [0 0 0 | 5]. The system is:",
      "o": [
        ["Consistent with infinitely many solutions", 0, ""],
        ["Homogeneous", 0, ""],
        ["Consistent with a unique solution", 0, ""],
        ["Inconsistent", 1, ""]
      ]
    },
    {
      "d": "02-ch1-lecture-2",
      "id": "99bb0268",
      "s": 13,
      "p": "A consistent system with 3 equations, 5 unknowns has:",
      "o": [
        ["Exactly one solution", 0, ""],
        ["Infinitely many solutions", 1, "At least 2 free variables."],
        ["No solution", 0, ""],
        ["Exactly two solutions", 0, ""]
      ]
    },
    {
      "d": "03-ch1-lecture-3",
      "id": "55a748bd",
      "s": 17,
      "p": "Span{u, v} always contains the zero vector.",
      "o": [
        ["True", 1, "0 = 0u + 0v."],
        ["False", 0, ""]
      ]
    },
    {
      "d": "04-ch1-lecture-4",
      "id": "4be2a808",
      "s": 8,
      "p": "A homogeneous system with more unknowns than equations:",
      "o": [
        ["Is inconsistent", 0, ""],
        ["Has only the trivial solution", 0, ""],
        ["Always has a nontrivial solution", 1, ""],
        ["Has exactly one solution", 0, ""]
      ]
    },
    {
      "d": "05-ch1-lecture-5",
      "id": "30212eac",
      "s": 5,
      "p": "Four vectors in ℝ³ are:",
      "o": [
        ["Cannot be decided", 0, ""],
        ["Always linearly dependent", 1, ""],
        ["Always independent", 0, ""],
        ["Independent if none is zero", 0, ""]
      ]
    },
    {
      "d": "05-ch1-lecture-5",
      "id": "bd460145",
      "s": 5,
      "p": "If a set contains the zero vector, it is linearly dependent.",
      "o": [
        ["True", 1, ""],
        ["False", 0, ""]
      ]
    },
    {
      "d": "06-ch1-lecture-6",
      "id": "17870804",
      "s": 12,
      "p": "Which map is NOT linear?",
      "o": [
        ["T(x) = 0", 0, ""],
        ["T(x) = Ax", 0, ""],
        ["T(x) = 3x", 0, ""],
        ["T(x) = x + (1, 0)", 1, "T(0) ≠ 0."]
      ]
    },
    {
      "d": "06-ch1-lecture-6",
      "id": "a767b957",
      "s": 25,
      "p": "T: ℝ³ → ℝ² can never be:",
      "o": [
        ["Onto", 0, ""],
        ["Linear", 0, ""],
        ["Represented by a matrix", 0, ""],
        ["One-to-one", 1, "3 columns in ℝ² are dependent."]
      ]
    },
    {
      "d": "07-ch2-lecture-1",
      "id": "2c337c63",
      "s": 4,
      "p": "A is 3×2 and B is 2×4. AB is:",
      "o": [
        ["2×2", 0, ""],
        ["4×3", 0, ""],
        ["3×4", 1, ""],
        ["undefined", 0, ""]
      ]
    },
    {
      "d": "07-ch2-lecture-1",
      "id": "76e77fd8",
      "s": 10,
      "p": "(AB)ᵀ equals:",
      "o": [
        ["AᵀBᵀ", 0, ""],
        ["AB", 0, ""],
        ["BA", 0, ""],
        ["BᵀAᵀ", 1, ""]
      ]
    },
    {
      "d": "08-ch2-lecture-2",
      "id": "a0b8a6e3",
      "s": 2,
      "p": "The inverse of [[2, 1], [5, 3]] is:",
      "o": [
        ["[[2, −1], [−5, 3]]", 0, ""],
        ["[[3, −1], [−5, 2]]", 1, "det = 1."],
        ["[[3, 1], [5, 2]]", 0, ""],
        ["It does not exist", 0, ""]
      ]
    },
    {
      "d": "08-ch2-lecture-2",
      "id": "3317d721",
      "s": 8,
      "p": "If A is n×n and Ax = 0 has a nontrivial solution, then A is invertible.",
      "o": [
        ["True", 0, ""],
        ["False", 1, "It is NOT invertible."]
      ]
    },
    {
      "d": "09-ch2-lecture-3",
      "id": "80a240ac",
      "s": 1,
      "p": "After factoring A = LU, solving Ax = b takes:",
      "o": [
        ["Ux = b, then Ly = x", 0, ""],
        ["Only Ux = b", 0, ""],
        ["Computing A⁻¹ first", 0, ""],
        ["Ly = b, then Ux = y", 1, ""]
      ]
    },
    {
      "d": "10-ch2-lecture-4",
      "id": "3b4902ff",
      "s": 1,
      "p": "Which is a subspace of ℝ²?",
      "o": [
        ["The first quadrant", 0, ""],
        ["The unit circle", 0, ""],
        ["A line through the origin", 1, ""],
        ["A line not through the origin", 0, ""]
      ]
    },
    {
      "d": "10-ch2-lecture-4",
      "id": "28bf1132",
      "s": 19,
      "p": "A 5×7 matrix has rank 4. dim Nul A =",
