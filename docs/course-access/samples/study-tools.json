{"lessons": [{"id": "divine-command-theory-new-explanation", "title": "Divine Command Theory \u2014 New Explanation", "url": "/course-access/samples/intro-video.mp4", "page": "/course-access/samples/", "caption": "/course-access/samples/captions/divine-command-theory-new-explanation.vtt", "chapters": [{"time": 0, "title": "Divine Command Theory"}, {"time": 57.34, "title": "Moral and immoral actions"}, {"time": 157.96, "title": "Punishment and reward"}, {"time": 218.14, "title": "Universal moral rules"}, {"time": 304.94, "title": "Objectivity"}, {"time": 370.62, "title": "Is the theory workable?"}], "transcript": [{"start": 0.0, "end": 0.68, "text": "\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643\u0645"}, {"start": 0.68, "end": 1.74, "text": "\u0627\u0644\u064a\u0648\u0645 \u0646\u0643\u0645\u0644 \u0639\u0646"}, {"start": 1.74, "end": 3.04, "text": "divine command theory"}, {"start": 3.04, "end": 4.88, "text": "\u0648\u0647\u0630\u0627 \u062a\u0631\u0649 \u0645\u0646 \u0627\u0641\u0636\u0644"}, {"start": 4.88, "end": 6.38, "text": "\u0627\u0644\u062b\u064a\u0631\u064a\u0632 \u0627\u0644\u0644\u064a \u0627\u0644\u0649 \u0627\u0644\u0627\u0646"}, {"start": 6.38, "end": 7.26, "text": "\u0628\u0646\u062a\u0643\u0644\u0645 \u0639\u0646\u0647\u0627"}, {"start": 7.26, "end": 8.1, "text": "\u0644\u064a\u0634\u061f"}, {"start": 8.1, "end": 9.16, "text": "\u0644\u0645\u0646 \u0643\u0644\u0645\u0629 divine"}, {"start": 9.16, "end": 10.28, "text": "\u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u0639\u0631\u0641\u0648\u0627 \u0627\u0646\u0647\u0627"}, {"start": 10.28, "end": 10.66, "text": "religious"}, {"start": 10.66, "end": 13.32, "text": "\u064a\u0639\u0646\u064a \u0648\u0634\u0648 \u0643\u0631\u0627\u0645 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 13.32, "end": 13.94, "text": "\u0642\u0627\u0644 \u0644\u0643\u0645 \u0647\u0646\u0627"}, {"start": 13.94, "end": 15.84, "text": "divine command theory is an ethical view"}, {"start": 15.84, "end": 16.72, "text": "based on faith"}, {"start": 16.72, "end": 18.58, "text": "or the belief that god exists"}, {"start": 18.58, "end": 20.18, "text": "\u064a\u0639\u0646\u064a \u0627\u062d\u0646\u0627 \u0643\u0644\u0646\u0627 \u0646\u0639\u0631\u0641"}, {"start": 20.18, "end": 22.0, "text": "\u0627\u0646 \u0641\u064a \u0631\u0628\u064a"}, {"start": 22.0, "end": 22.96, "text": "\u0648\u0627\u0646 \u0631\u0628\u064a"}, {"start": 22.96, "end": 25.06, "text": "\u0643\u0644 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0644\u064a \u0627\u0635\u062f\u0631\u0647\u0627"}, {"start": 25.06, "end": 25.88, "text": "\u0647\u064a \u0627\u0644\u0635\u062d"}, {"start": 25.88, "end": 27.32, "text": "\u0648\u0627\u0644\u0644\u064a \u0645\u0641\u0631\u0648\u0636 \u0646\u062a\u0628\u0639\u0647\u0627"}, {"start": 27.32, "end": 28.5, "text": "\u0641\u0639\u0634\u0627\u0646 \u0643\u062f\u0647"}, {"start": 28.5, "end": 30.28, "text": "\u0647\u0630\u0627 \u0635\u0648\u0648\u0627 \u0639\u0644\u064a\u0647"}, {"start": 30.28, "end": 32.28, "text": "command theory"}, {"start": 32.28, "end": 33.96, "text": "\u0642\u0627\u0644 \u0644\u0643\u0645 followers of the theory"}, {"start": 33.96, "end": 36.12, "text": "accept that all moral judgments is derived"}, {"start": 36.12, "end": 38.48, "text": "from the understanding of God's direct\ncommandments"}, {"start": 38.48, "end": 39.58, "text": "\u064a\u0639\u0646\u064a \u0627\u064a\u0634"}, {"start": 39.58, "end": 42.18, "text": "\u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0632\u064a \u0645\u0627 \u0642\u0644\u062a \u0644\u0643\u0645 \u0627\u0644\u0644\u064a \u0631\u0628\u064a \u062a\u0627\u0645\u062d \u0644\u0647\u0627"}, {"start": 42.18, "end": 44.06, "text": "\u0627\u0646 \u0646\u0633\u0648\u064a\u0647\u0627 \u0648\u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0644\u064a \u0644\u0627"}, {"start": 44.06, "end": 46.36, "text": "\u0632\u064a \u0645\u062b\u0644 \u0627\u0644\u062d\u064a\u0646 \u062d\u0627\u0631\u0645 \u0645\u0646\u0627"}, {"start": 46.36, "end": 48.22, "text": "\u0627\u0644\u0643\u062d\u0648\u0644 \u0627\u0644\u0645\u062e\u062f\u0631\u0627\u062a"}, {"start": 48.22, "end": 50.26, "text": "\u0627\u0644\u0645\u0636\u0631\u0629 \u064a\u0639\u0646\u064a \u0645\u0627 \u062a\u0643\u0644\u0645 \u0639\u0646 \u0623\u062f\u0648\u064a\u0629"}, {"start": 50.26, "end": 53.58, "text": "\u0627\u0644\u0645\u062e\u062f\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0643\u0644 \u0627\u0644\u062e\u0646\u0632\u064a\u0631\u064a"}, {"start": 53.58, "end": 54.76, "text": "\u0647\u0630\u0627 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0635\u062d"}, {"start": 54.76, "end": 57.34, "text": "\u0641\u0625\u062d\u0646\u0627 \u0642\u0627\u0639\u062f\u0646\u0627 \u0646\u062a\u0628\u0639 \u0647\u0630\u0627 \u0627\u0644\u0643\u0644\u0627\u0645"}, {"start": 57.34, "end": 61.627, "text": "In other words, what is an accordance with\nGod's command is moral and what is"}, {"start": 61.627, "end": 63.52, "text": "contrary to the command is immoral"}, {"start": 63.52, "end": 68.4, "text": "\u064a\u0639\u0646\u064a \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0644\u064a \u0642\u0627\u0644 \u0639\u0627\u062f\u064a \u0646\u0633\u0648\u064a\u0647\u0627 \u0647\u0627\n\u0628\u0623\u0634\u064a\u0627\u0621 \u0643\u0648\u064a\u0633\u0629"}, {"start": 68.4, "end": 70.58, "text": "\u0645\u0641\u0631\u0648\u0636 \u0639\u0627\u062f\u064a \u0646\u062a\u062d\u0645\u0633 \u0648\u0646\u062d\u0646 \u0646\u0633\u0648\u064a\u0647\u0627"}, {"start": 70.58, "end": 73.26, "text": "\u0628\u0633 \u0648\u0627\u0644\u0644\u0647 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0644\u064a \u0645\u0627 \u0646\u062d\u0646\u0647\u0627 \u0644\u0627"}, {"start": 73.26, "end": 76.4, "text": "\u0647\u0630\u0627 \u0647\u0648 \u0639\u0634\u0627\u0646 \u0643\u062f\u0642 \u0644\u0643\u0645 contrary \u0648\u0628\u062f\u0646 \u0646\u0642\u0627\u0644 \u0644\u0643\u0645\nmoral"}, {"start": 76.4, "end": 78.12, "text": "\u0639\u0644\u0649 \u062d\u0633\u0628 \u0648\u0634 \u0648\u0627\u0644\u0636\u0628\u0637 \u0637\u0628\u0639\u0627"}, {"start": 78.12, "end": 80.4, "text": "\u0648\u0634 \u0648\u0647\u0648 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0642\u0627\u0644 \u0644\u0643\u0645 good action"}, {"start": 80.4, "end": 86.92, "text": "\u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0632\u064a\u0646\u0629 \u0627\u0644\u0645\u062a\u0635\u0631\u0641\u0627\u062a \u0627\u0644\u0644\u064a \u0645\u0641\u0631\u0648\u0636 \u0639\u0627\u062f\u064a\n\u0646\u0633\u0645\u0648\u062d \u0644\u0646\u0627 \u0648\u0645\u0643\u064a \u062d\u062a\u0649 \u0645\u0646 \u0627\u0644\u0645\u062d\u0628 \u0623\u0646 \u0646\u0633\u0648\u064a\u0647\u0627"}, {"start": 86.92, "end": 89.46000000000001, "text": "\u064a\u0639\u0646\u064a \u0631\u0628 \u064a\u0642\u0648\u0644"}, {"start": 89.46000000000001, "end": 91.36, "text": "\u0633\u0648\u0648\u0647\u0627 \u0645\u0633\u0645\u0648\u062d \u0644\u0643\u0645"}, {"start": 91.36, "end": 92.96000000000001, "text": "\u0648\u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0644\u064a \u0645\u0628"}, {"start": 92.96000000000001, "end": 95.38, "text": "\u0643\u0648\u064a\u0633\u0629 \u0645\u0636\u0631\u0629"}, {"start": 95.38, "end": 97.42, "text": "\u0648\u0628\u062f\u062a\u0639\u062f\u0645 \u0627\u0644\u062d\u064a\u0627\u0629"}, {"start": 97.42, "end": 99.3, "text": "\u0647\u064a \u0633\u0628\u062d\u0627\u0646 \u0627\u0644\u0644\u0647 \u062a\u0639\u0643\u0633"}, {"start": 99.3, "end": 100.4, "text": "\u0643\u0644\u0627\u0645 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 100.4, "end": 101.22, "text": "\u0648\u0642\u0627\u0644 \u0644\u0643\u0645"}, {"start": 101.22, "end": 107.44, "text": "\u0644\u0644\u0623\u0633\u0641 \u0637\u0628\u0639\u0627 \u0641\u064a \u0623\u0643\u062b\u0631 \u0645\u0646 \u062f\u064a\u0646"}, {"start": 107.44, "end": 109.25999999999999, "text": "\u0641\u0643\u0644 \u0648\u0627\u062d\u062f"}, {"start": 109.25999999999999, "end": 111.64, "text": "\u064a\u0628\u064a \u0639\u0646\u062f\u0647 \u0643\u062a\u0627\u0628 \u0648\u0643\u0644 \u0648\u0627\u062d\u062f \u0639\u0646\u062f\u0647"}, {"start": 111.64, "end": 113.24000000000001, "text": "\u064a\u0639\u0646\u064a \u0643\u0644\u0627\u0645 \u0631\u0628\u0647"}, {"start": 113.24000000000001, "end": 115.14, "text": "\u0648\u0634 \u064a\u0639\u0646\u064a \u0645\u0641\u0631\u0648\u0636 \u064a\u0633\u0648\u064a"}, {"start": 115.14, "end": 116.52000000000001, "text": "\u064a\u0642\u0648\u0644\u0643\u0645 \u0647\u0646\u0627"}, {"start": 116.52000000000001, "end": 124.2, "text": "\u0644\u0627\u062d\u0638\u0648\u0627 \u0623\u0646 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646"}, {"start": 124.2, "end": 126.0, "text": "Divine Command Theory"}, {"start": 126.0, "end": 127.2, "text": "\u0648\u0627\u0644\u0631\u064a\u0644\u062a\u0632\u0645"}, {"start": 127.2, "end": 130.16, "text": "\u0623\u0646\u0627 \u0648\u0634 \u0623\u062d\u0633 \u0635\u062d"}, {"start": 130.16, "end": 131.34, "text": "\u0648\u0634 \u063a\u0644\u0637"}, {"start": 131.34, "end": 132.46, "text": "\u0628\u0633 Divine"}, {"start": 132.46, "end": 134.54, "text": "\u0637\u0628\u0639\u0627 \u0627\u0644\u0628\u0634\u0631 \u062a\u0631\u064a\u062f \u064a\u063a\u0644\u0637 \u0635\u062d"}, {"start": 134.54, "end": 137.5, "text": "\u0641\u0647\u0630\u0627 \u0647\u0648 \u0623\u0643\u0628\u0631 \u0645\u0634\u0627\u0643\u0644 \u0644\u0644\u0631\u064a\u0644\u062a\u0632\u0645"}, {"start": 137.5, "end": 139.22, "text": "\u0628\u0633 Divine Command Theory"}, {"start": 139.22, "end": 141.14, "text": "\u062f\u0627\u0645 \u0643\u0644\u0627\u0645 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 141.14, "end": 143.18, "text": "\u0645\u0639\u0627\u0646\u0627\u0629 \u0623\u0646\u0647 \u0644\u0627 \u064a\u0648\u062c\u062f \u062e\u0637\u0623"}, {"start": 143.18, "end": 144.28, "text": "\u0644\u0627 \u064a\u0648\u062c\u062f human error"}, {"start": 144.28, "end": 149.98, "text": "\u0641\u0639\u0634\u0627\u0646 \u0643\u062f\u0647 \u0645\u0631\u0629 \u064a\u0642\u062f\u0631 \u0633\u0627\u0639\u062f\u0646\u0627 \u0628\u0623\u0646\u0646\u0627 \u0646\u0639\u0631\u0641 \u0648\u0634\u0647\n\u0627\u0644\u0635\u062d \u0648\u0634\u0647 \u0627\u0644\u063a\u0644\u0637"}, {"start": 149.98, "end": 152.82, "text": "\u0648\u062e\u0644\u0648\u0646\u0627 \u0646\u062a\u0643\u0644\u0645 \u0639\u0646 \u0627\u0644\u0623\u062f\u0628\u0627\u0646\u062a\u062c\u0632"}, {"start": 152.82, "end": 153.74, "text": "\u0642\u0627\u0644 \u0644\u0643\u0645 \u0647\u0646\u0627"}, {"start": 153.74, "end": 155.94, "text": "We owe obedience to our creator"}, {"start": 155.94, "end": 157.96, "text": "\u0637\u0628\u0639\u0627 \u0644\u0627\u0632\u0645 \u0646\u0633\u0645\u0639 \u0643\u0644\u0627\u0645 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 157.96, "end": 160.54, "text": "If you disobey God you will be punished"}, {"start": 160.54, "end": 163.3, "text": "\u0637\u0628\u0639\u0627 \u064a\u0639\u0646\u064a \u0641\u064a\u0647 \u0623\u0635\u0644\u0627 \u0634\u064a \u064a\u0633\u0645\u0639 \u0646\u0627\u0631 \u062c\u0647\u0646\u0645"}, {"start": 163.3, "end": 165.7, "text": "If you follow his command you will be\nrewarded"}, {"start": 165.7, "end": 167.5, "text": "\u0623\u0643\u064a\u062f \u0627\u0644\u062c\u0646\u0629"}, {"start": 167.5, "end": 168.42000000000002, "text": "\u0642\u0627\u0644 \u0644\u0643\u0645 \u0647\u0646\u0627 \u0628\u0631\u0636\u0648"}, {"start": 168.42000000000002, "end": 170.66, "text": "God is all good and all knowing"}, {"start": 170.66, "end": 172.68, "text": "\u0637\u0628\u0639\u0627 \u0644\u0623\u0646 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 172.68, "end": 174.8, "text": "\u062e\u0628\u064a\u0631"}, {"start": 174.8, "end": 177.56, "text": "\u0648\u064a\u0639\u0631\u0641 \u0643\u0644 \u0634\u064a\u0621"}, {"start": 177.56, "end": 179.3, "text": "\u0648\u064a\u0639\u0631\u0641 \u0645\u0635\u0644\u062d\u062a\u0646\u0627 \u062d\u062a\u0649 \u0648\u0625\u062d\u0646\u0627"}, {"start": 179.3, "end": 181.22, "text": "\u0645\u0627 \u0646\u0639\u0631\u0641\u0647 \u0641\u0623\u0643\u064a\u062f \u0623\u0646"}, {"start": 181.22, "end": 182.76, "text": "\u0623\u064a \u0642\u0631\u0627\u0631 \u0647\u0648 \u0628\u064a\u0635\u062f\u0631\u0647"}, {"start": 182.76, "end": 185.26, "text": "\u0645\u0639\u0646\u0627\u062a\u0647 \u0623\u0646\u0647 \u0634\u064a\u0621 \u0644\u0646\u0627 \u0645\u0646 \u0628\u0627\u0628"}, {"start": 185.26, "end": 187.3, "text": "\u0627\u0644\u0635\u0627\u0644\u062d \u0644\u0646\u0627 \u0645\u062b\u0644\u0627 \u0632\u064a \u0627\u0644\u0623\u0643\u0644"}, {"start": 187.3, "end": 189.38, "text": "\u0627\u0644\u062e\u0646\u0632\u064a\u0631 \u0625\u062d\u0646\u0627 \u0645\u0627 \u0646\u0639\u0631\u0641 \u0645\u0648\u0634 \u0648\u0627\u0644\u0623\u0634\u064a\u0627\u0621"}, {"start": 189.38, "end": 190.94, "text": "\u0627\u0644\u0644\u064a \u0645\u0645\u0643\u0646 \u062a\u0636\u0631\u0646\u0627"}, {"start": 190.94, "end": 193.02, "text": "\u0645\u0645\u0643\u0646 \u064a\u0639\u0646\u064a \u0648\u0627\u062d\u062f \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a \u064a\u0642\u0648\u0644 \u0648\u0627\u0644\u0644\u0647"}, {"start": 193.02, "end": 195.44, "text": "\u0644\u064a\u0634 \u0645\u0627 \u062a\u0623\u0643\u0644 \u0627\u0644\u062e\u0646\u0632\u064a\u0631 \u0645\u0631\u0629 \u0644\u0630\u064a\u0630"}, {"start": 195.44, "end": 197.34, "text": "\u0648\u0627\u0644\u0644\u0647 \u0625\u062d\u0646\u0627 \u0631\u0628\u064a \u0642\u0627\u0644 \u0645\u0645\u0646\u0648\u0639"}, {"start": 197.34, "end": 199.26, "text": "\u0644\u064a\u0634 \u062c\u0631\u0628\u0648\u0627"}, {"start": 199.26, "end": 201.46, "text": "\u062d\u062a\u0649 \u062c\u0631\u0628\u0648\u0627 \u0628\u0633 \u0625\u062d\u0646\u0627 \u0645\u0627 \u0646\u062f\u0631"}, {"start": 201.46, "end": 207.57999999999998, "text": "\u0648\u0644\u064a\u0634 \u0645\u062d\u0631\u0645\u0629 \u0628\u0633 \u0627\u062d\u0646\u0627 \u0639\u0627\u0631\u0641\u064a\u0646 \u062f\u0627\u0645\u0629 \u0645\u062d\u0631\u0645\u0629\n\u0645\u0639\u0646\u0627\u062a\u0647 \u0627\u0646\u0647 \u0645\u0636\u0631 \u0623\u0648 \u0628\u0636\u0631\u0646\u0627 \u0628\u0634\u0643\u0644 \u0645\u0627"}, {"start": 207.57999999999998, "end": 208.3, "text": "\u0628\u062f\u064a\u0646 \u0642\u0627\u0644 \u0644\u0643\u0645 \u0647\u0646\u0627"}, {"start": 208.3, "end": 209.8, "text": "God is the ultimate authority"}, {"start": 209.8, "end": 212.8, "text": "\u064a\u0639\u0646\u064a \u0645\u0627 \u0641\u064a\u0647 \u0627\u064a \u0627\u062d\u062f \u0641\u0648\u0642 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 212.8, "end": 213.94, "text": "\u0645\u0648 \u0645\u062b\u0644\u0627 \u0632\u064a \u0645\u0644\u0643"}, {"start": 213.94, "end": 215.76, "text": "\u062d\u062a\u0649 \u0627\u0644\u0645\u0644\u0643 \u0641\u064a\u0647 \u0641\u0648\u0642\u0647"}, {"start": 215.76, "end": 217.07999999999998, "text": "\u0627\u0644\u0644\u064a \u0647\u0648 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 217.07999999999998, "end": 218.14, "text": "\u0628\u0631\u0636\u064a \u0642\u0627\u0644 \u0644\u0643\u0645"}, {"start": 218.14, "end": 221.84, "text": "God's command sets forth of universal\nmoral rules"}, {"start": 221.84, "end": 225.66, "text": "\u0637\u0628\u0639\u0627 \u0644\u0623\u0646 \u0643\u062a\u0627\u0628 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646 \u064a\u0645\u062f\u064a\u0643\u0645 \u062a\u0648\u0646 \u0639\u0644\u064a\u0647\nuniversalize"}, {"start": 225.66, "end": 229.24, "text": "\u0648 the rules can be applied to anyone at\nall times and places"}, {"start": 229.24, "end": 232.62, "text": "\u064a\u0639\u0646\u064a \u0645\u0647\u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0648\u0642\u062a \u0623\u0648 \u0627\u0644\u0632\u0645\u0646 \u0623\u0648 \u0627\u0644\u0628\u0644\u062f"}, {"start": 232.62, "end": 234.3, "text": "\u0643\u0644\u0647 \u064a\u0637\u0628\u0642 \u0639\u0644\u064a\u0647\u0645"}, {"start": 234.3, "end": 236.94, "text": "The beliefs of God is eternal and never\nchanges"}, {"start": 236.94, "end": 238.32, "text": "\u0645\u0639\u0646\u0649 \u0637\u0628\u0639\u0627 \u0628\u0634\u0631\u0629 \u0644\u0627 \u064a\u062a\u063a\u064a\u0631"}, {"start": 238.32, "end": 240.36, "text": "\u0642\u0628\u0644 \u0627\u0644\u062d\u064a\u0646 \u0642\u0628\u0644 \u0627\u0644\u062d\u064a\u0646"}, {"start": 240.36, "end": 244.64, "text": "\u0642\u0628\u0644 \u0627\u0644\u062d\u064a\u0646 \u0642\u0628\u0644 \u0627\u0644\u062d\u064a\u0646 \u0643\u0627\u0646 \u0623\u0648\u0628\u0627\u0645\u0627"}, {"start": 244.64, "end": 245.76, "text": "\u0648\u0627\u0644\u0644\u064a \u0642\u0628\u0644 \u0627\u0644\u0644\u0647 \u0623\u0639\u0644\u0645"}, {"start": 245.76, "end": 246.96, "text": "\u0644\u0627 \u062a\u0634\u0648\u0641\u0648\u0646 \u0643\u064a\u0641 \u064a\u062a\u063a\u064a\u0631"}, {"start": 246.96, "end": 248.54, "text": "\u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646 \u0645\u0627 \u064a\u062a\u063a\u064a\u0631"}, {"start": 248.54, "end": 249.44, "text": "\u0645\u0627 \u0641\u064a\u0647 \u0625\u0644\u0627 \u0648\u0627\u062d\u062f"}, {"start": 249.44, "end": 251.08, "text": "\u0641\u0647\u0630\u0627 \u0648\u0627\u062d\u062f \u0645\u0646 \u0627\u0644\u0623\u0633\u0628\u0627\u0628"}, {"start": 251.08, "end": 252.84, "text": "\u0627\u0644\u0644\u064a \u0628\u0631\u0636\u0648 \u064a\u0639\u0646\u064a \u064a\u062d\u0641\u0632"}, {"start": 252.84, "end": 254.4, "text": "\u0625\u0646\u0646\u0627 \u0646\u062a\u0628\u0639 \u0627\u0644\u0643\u0645\u0627\u0646\u062f theory"}, {"start": 254.4, "end": 255.7, "text": "\u0628\u0631\u0636\u0648 \u0642\u0627\u0644 \u0644\u0643\u0645 \u0647\u0646\u0627"}, {"start": 255.7, "end": 258.18, "text": "that means that his commands are relevant\ntoday"}, {"start": 258.18, "end": 259.94, "text": "as when they were first recorded"}, {"start": 259.94, "end": 262.68, "text": "\u0637\u0628\u0639\u0627\u064b \u0623\u0646 \u062a\u0641\u0643\u0631\u0648\u0627 \u0645\u062a\u0649 \u0627\u0644\u0642\u0631\u0622\u0646"}, {"start": 262.68, "end": 263.58, "text": "\u0625\u0646 \u0643\u062a\u0627\u0628"}, {"start": 263.58, "end": 265.9, "text": "\u0648\u0625\u0644\u0649 \u0627\u0644\u0622\u0646 \u0625\u062d\u0646\u0627 \u0646\u062a\u0628\u0639\u0647"}, {"start": 265.9, "end": 266.94, "text": "\u0644\u064a\u0634 \u0646\u062a\u0628\u0639\u0647\u061f"}, {"start": 266.94, "end": 267.46, "text": "\u0644\u0623\u0646\u0647 \u0642\u0646"}, {"start": 267.46, "end": 268.78, "text": "\u0631\u0628\u064a \u0625\u062a\u0631\u0646\u0627\u0644"}, {"start": 268.78, "end": 270.26, "text": "\u0645\u0627 \u064a\u0645\u0648\u062a"}, {"start": 270.26, "end": 273.26, "text": "\u0645\u0627 \u064a\u0641\u062c\u0623 \u064a\u0631\u0648\u062d \u0639\u0646\u0646\u0627"}, {"start": 273.26, "end": 276.46, "text": "\u0641\u0625\u062d\u0646\u0627 \u062e\u0644\u0627\u0635 \u0639\u0627\u0631\u0641\u064a\u0646 \u0623\u0646 \u0643\u0644\u0627\u0645 \u062b\u0627\u0628\u062a"}, {"start": 276.46, "end": 278.38, "text": "\u0637\u0628\u0639\u0627\u064b \u0644\u0643\u0630\u0627 \u0623\u0643\u062a\u0628\u062a \u0644\u0643\u0645 \u0647\u0646\u0627 \u0646\u0648\u062a"}, {"start": 278.38, "end": 280.08, "text": "\u0623\u0646 unlike \u0627\u0644\u0631\u064a\u0644\u062a\u0632\u0645"}, {"start": 280.08, "end": 281.88, "text": "where it uses the highest stakeholder"}, {"start": 281.88, "end": 282.62, "text": "\u0627\u0644\u0644\u064a \u0647\u0648 \u0628\u0634\u0631"}, {"start": 282.62, "end": 284.0, "text": "in that in case they're human"}, {"start": 284.0, "end": 287.62, "text": "\u0643\u0645\u0627\u0646 theory \u0644\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 God"}, {"start": 287.62, "end": 288.38, "text": "\u0627\u0644\u0644\u064a \u0647\u0648 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 288.38, "end": 290.34000000000003, "text": "\u0641\u0647\u0648 \u0627\u0644\u0623\u0635\u0644"}, {"start": 290.34000000000003, "end": 292.44, "text": "\u0627\u0644\u0647\u064a\u0633\u062a \u0647\u0627\u064a\u0633\u062a \u0647\u0627\u064a\u0633\u062a \u062a\u064a\u0643\u0648\u062f\u064a"}, {"start": 292.44, "end": 294.42, "text": "\u0645\u0627 \u0641\u064a \u0623\u062d\u062f \u0623\u0639\u0644\u0649 \u0645\u0646\u0647"}, {"start": 294.42, "end": 296.15999999999997, "text": "\u0648\u0628\u0639\u062f\u064a\u0646 \u0637\u0628\u0639\u0627 \u0632\u064a\u0627\u062f\u0629"}, {"start": 296.15999999999997, "end": 298.42, "text": "\u0628\u0646\u064a\u0641\u062a\u0633 \u0644\u0623\u0646 \u0627\u0644\u0628\u064a\u0646\u064a\u0641\u062a\u0633 \u0637\u0628\u0639\u0627"}, {"start": 298.42, "end": 299.38, "text": "\u0645\u0627 \u064a\u0645\u062f\u064a\u0643\u0645"}, {"start": 299.38, "end": 301.98, "text": "\u064a\u0639\u0638\u0648\u0646 \u0647\u0645 \u0639\u0635\u0645 \u062d\u062f\u064a\u0646\u0647\u0627 \u0639\u0644\u0649 \u0633\u062a\u0629 \u0639\u0634\u0627\u0646"}, {"start": 301.98, "end": 303.56, "text": "\u0628\u0633 \u0625\u062d\u0646\u0627 they don't overwhelm us"}, {"start": 303.56, "end": 304.94, "text": "\u0628\u0633 \u0625\u0646\u0627 \u0643\u064a\u062f \u0641\u064a \u0632\u064a\u0627\u062f\u0629 \u062d\u062a\u0649"}, {"start": 304.94, "end": 307.58, "text": "\u0642\u0627\u0644 \u0644\u0643\u0645 God's command doesn't depend"}, {"start": 307.58, "end": 309.84, "text": "on what others think are right or wrong"}, {"start": 309.84, "end": 312.04, "text": "His commands are completely objective"}, {"start": 312.04, "end": 315.5, "text": "\u0644\u0627\u062d\u0638\u0648\u0627 \u0639\u0634\u0627\u0646 \u0643\u0630\u0627 \u0647\u0648 \u0623\u0635\u0644\u0627 \u064a\u0642\u062f\u0631 \u064a\u0635\u064a\u0631\nuniversalized"}, {"start": 315.5, "end": 321.26, "text": "\u0644\u0623\u0646\u0647 \u0645\u0627 \u064a\u0645\u062f\u064a \u0623\u062d\u062f \u064a\u0642\u0648\u0644 \u0623\u0646\u0627 \u0645\u0627 \u0623\u0635\u062f\u0642 \u0623\u0648 \u0623\u0646\u0627\n\u0645\u0628\u0631\u0627\u064a"}, {"start": 321.26, "end": 327.5, "text": "\u0644\u064a\u0634 \u0644\u0623\u0646\u0647 \u062e\u0644\u0627\u0635 \u0643\u0644\u0627\u0645 \u0631\u0628 \u0627\u0644\u0639\u0628\u064a\u0646 \u0645\u0627 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649\n\u0623\u064a \u0643\u0644\u0627\u0645 \u0634\u062e\u0635 \u062a\u0627\u0646\u064a"}, {"start": 327.5, "end": 330.5, "text": "\u0645\u062d\u062f \u064a\u0642\u062f\u0631 \u064a\u062f\u062e\u0644 \u0648\u064a\u0642\u0648\u0644 \u0643\u0644\u0627\u0645 \u0645\u062e\u062a\u0644\u0641"}, {"start": 330.5, "end": 331.36, "text": "\u0628\u0631\u0636\u0648 \u064a\u0642\u0648\u0644 \u0644\u0643\u0645"}, {"start": 331.36, "end": 334.78, "text": "religious text allows us to know and\nunderstand the character of God"}, {"start": 334.78, "end": 337.74, "text": "and they make it easier to know how to act\nmorally"}, {"start": 337.74, "end": 340.98, "text": "\u0637\u0628\u0639\u0627 \u064a\u0639\u0646\u064a \u0627\u0644\u0642\u0631\u0622\u0646 \u064a\u0639\u0644\u0645\u0646\u0627"}, {"start": 340.98, "end": 342.4, "text": "\u0647\u0646\u0627 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0646\u0627 \u0646\u062d\u0646 \u0627\u0644\u0642\u0631\u0622\u0646"}, {"start": 342.4, "end": 344.7, "text": "\u064a\u0639\u0644\u0645\u0646\u0627 \u0639\u0646 \u0635\u0641\u0627\u062a \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 344.7, "end": 346.46, "text": "\u0643\u064a\u0641 \u0647\u0648 \u0643\u0631\u064a\u0645 \u0643\u064a\u0641 \u0647\u0648 \u0631\u062d\u064a\u0645"}, {"start": 346.46, "end": 348.92, "text": "\u0643\u064a\u0641 \u0647\u0648 \u064a\u0642\u062f\u0631\u0646\u0627 \u0641\u064a \u0645\u0634\u0627\u0643\u0644\u0646\u0627"}, {"start": 348.92, "end": 349.86, "text": "\u0648\u062d\u064a\u0627\u062a\u0646\u0627"}, {"start": 349.86, "end": 352.04, "text": "\u0643\u0644 \u0634\u064a\u0621 \u0639\u0631\u0641\u062a\u0647"}, {"start": 352.04, "end": 355.5, "text": "\u0641\u0625\u062d\u0646\u0627 \u0625\u0630\u0627 \u0639\u0631\u0641\u0646\u0627 \u0643\u0644 \u0635\u0641\u0627\u062a \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646"}, {"start": 355.5, "end": 357.54, "text": "\u0648\u0646\u062d\u0627\u0648\u0644 \u0642\u062f\u0631 \u0627\u0644\u0645\u0643\u0627\u0646"}, {"start": 357.54, "end": 359.02, "text": "\u0623\u0646\u0646\u0627 \u0623\u0635\u0644\u0627 \u0646\u062d\u0627\u0648\u0644"}, {"start": 359.02, "end": 361.08, "text": "\u064a\u0639\u0646\u064a \u0637\u0628\u0639\u0627 \u0646\u062d\u0627\u0648\u0644 \u0623\u0646 \u0646\u0635\u064a\u0631 \u0632\u064a"}, {"start": 361.08, "end": 363.44, "text": "\u0647\u0630\u0627 \u064a\u0633\u0627\u0639\u062f\u0646\u0627 \u0623\u0646 \u0646\u0639\u0631\u0641 \u0643\u064a\u0641"}, {"start": 363.44, "end": 365.22, "text": "\u0648\u0646\u062a\u0635\u0631\u0641 \u0628\u0637\u0631\u064a\u0642\u0629 \u0645\u0648\u0631\u0644\u064a"}, {"start": 365.22, "end": 367.2, "text": "\u0648\u0628\u0633 \u0648\u0627\u0644\u0644\u0647 \u062d\u062a\u0649 \u0644\u0627\u062d\u0638\u0648\u0627"}, {"start": 367.2, "end": 369.04, "text": "\u0623\u0646\u0647 \u0645\u0627 \u0641\u064a \u0623\u064a \u0639\u064a\u0648\u0628"}, {"start": 369.04, "end": 370.62, "text": "\u0641\u064a \u0627\u0644\u0643\u0645\u0627\u0646\u062f \u062b\u064a\u0631\u064a"}, {"start": 370.62, "end": 372.84, "text": "\u0648\u062a\u0631\u0649 \u0647\u0630\u0627 Workable Theory"}, {"start": 372.84, "end": 374.84, "text": "\u0623\u0646\u0627 \u0645\u062f\u0644\u0634 \u0648\u0644\u0627 \u0645\u0645\u0643\u0646 \u0637\u0645\u0631\u062a\u0647\u0627"}, {"start": 374.84, "end": 376.68, "text": "\u0628\u0633 \u0625\u0646\u0647 \u0647\u0630\u0627 \u064a\u0639\u062a\u0628\u0631"}, {"start": 376.68, "end": 377.76, "text": "Workable Theory"}, {"start": 377.76, "end": 381.32, "text": "\u0648\u0625\u0630\u0627 \u0639\u0646\u062f\u0643\u0645 \u0623\u064a \u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u0623\u0648 \u0623\u064a \u0645\u0634\u0643\u0644\u0629 \u0628\u0647\u0630\u0627\n\u0627\u0644\u0634\u0627\u0628\u062a\u0631"}, {"start": 381.32, "end": 382.58, "text": "\u062a\u0648\u0627\u0635\u0644\u0648\u0627 \u0645\u0639\u064a \u0639\u0644\u0649 \u0627\u0644\u0648\u0627\u062a\u0633"}]}], "routes": {}}